{
  "name": "rest-api",
  "version": "1.0.0",
  "description": "*RESTful Express/Node API.*",
  "main": "index.js",
  "scripts": {
    "dev": "node src/app.js",
    "eslint": "eslint --fix . --ignore-pattern 'tests/*'",
    "test": "export NODE_ENV=test && node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --coverage --forceExit",
    "buildtests": "mongosh test --eval 'db.dropDatabase()' && npm run testimport",
    "testimport": "cd testdb && mongoimport --db test -c bikes --jsonArray addbikes.json && mongoimport --db test -c users --jsonArray addusers.json && mongoimport --db test -c cities --jsonArray addcities.json && mongoimport --db test -c parking_zones --jsonArray addparking.json && mongoimport --db test -c charging_stations --jsonArray addcharging.json && mongoimport --db test -c trips --jsonArray addtrips.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "socket.io": "^4.8.1",
    "stripe": "^17.5.0",
    "supertest": "^7.0.0"
  },
  "type": "module",
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "eslint": "^8.57.1",
    "javascript-style-guide": "^1.0.1",
    "jest": "^29.7.0"
  }
}
